import os
import sys

_here = os.path.dirname(os.path.realpath(__file__))
for _p in (os.path.join(_here, "..", "share", "monad"), os.path.join(_here, "..")):
    if os.path.isdir(os.path.join(_p, "monad")):
        sys.path.insert(0, os.path.abspath(_p))
        break

from monad.main import main  # noqa: E402

sys.exit(main())
